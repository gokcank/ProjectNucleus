# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local scratch notes (manual verification checklist, not part of the product)
scratch_list.md

# Snap build output. The .deb and AppImage land under src-tauri/target/,
# which Cargo's own ignore file already covers; snapcraft writes here instead.
*.snap
/parts/
/stage/
/prime/

# Flatpak build output. These stay inside the project on purpose: running the
# builder from its own flatpak means paths under different mounts are separate
# filesystems to it, and hardlinking between them fails.
/.flatpak-builder/
/.flatpak-build/
/.flatpak-repo/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
